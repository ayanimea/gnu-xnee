%.eps:%.dia
	@echo "creating EPS"
	$(DIA) --nosplash -e $@ $<

%.pdf: %.texi
	@echo "creating PDF"
	$(TEXI2PDF)   $<

%.pdf: %.eps
	@echo "creating PDF"
	$(EPSTOPDF) --outfile $@ $<

%.png: %.eps
	@echo "creating PNG"
	$(CONVERT) -density 144x144 $< $@ 
	( mv $@ `echo $@ | sed 's,\.png,_big\.png,g'` )
	$(CONVERT) -density 32x32 $< $@ 
	( mv $@ `echo $@ | sed 's,\.png,_small\.png,g'` )
	$(CONVERT) -density 60x60 $< $@ 
%.jpg: %.eps
	echo "creating JPG"
	$(CONVERT) -density 144x144 $< $@ 
	( mv $@ `echo $@ | sed 's,\.jpg,_big\.jpg,g'` )
	$(CONVERT) -density 32x32 $< $@ 
	( mv $@ `echo $@ | sed 's,\.jpg,_small\.jpg,g'` )
	$(CONVERT) -density 60x60 $< $@ 

${IMG_EPS}: ${IMG_DIA}
${IMG_PDF}: ${IMG_EPS} 
${IMG_PNG}: ${IMG_EPS}
${IMG_JPG}: ${IMG_EPS}

